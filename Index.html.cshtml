<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bonsai Care - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f0f4f0; }
        .bonsai-card { transition: transform 0.2s; }
        .bonsai-card:hover { transform: translateY(-5px); }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #e2e8f0; }
        ::-webkit-scrollbar-thumb { background: #84cc16; border-radius: 10px; }
    </style>
</head>
<body class="text-slate-800">

    <div class="min-h-screen flex flex-col md:flex-row">
        <!-- Sidebar -->
        <aside class="w-full md:w-64 bg-emerald-900 text-white p-6 shadow-xl">
            <div class="flex items-center gap-3 mb-10">
                <div class="bg-white p-2 rounded-lg">
                    <i class="fas fa-seedling text-emerald-700 text-2xl"></i>
                </div>
                <h1 class="text-xl font-bold tracking-tight">BonsaiManager</h1>
            </div>
            <nav class="space-y-4">
                <button onclick="switchTab('dashboard')" class="w-full flex items-center gap-3 p-3 rounded-lg hover:bg-emerald-800 transition bg-emerald-800/50">
                    <i class="fas fa-chart-pie w-6"></i> Dashboard
                </button>
                <button onclick="switchTab('inventory')" class="w-full flex items-center gap-3 p-3 rounded-lg hover:bg-emerald-800 transition">
                    <i class="fas fa-tree w-6"></i> Inventário
                </button>
                <button onclick="openModal()" class="w-full flex items-center gap-3 p-3 rounded-lg bg-lime-500 hover:bg-lime-600 text-emerald-950 font-bold transition mt-10">
                    <i class="fas fa-plus w-6"></i> Novo Bonsai
                </button>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 p-4 md:p-8 overflow-y-auto">

            <header class="flex justify-between items-center mb-8">
                <div>
                    <h2 id="page-title" class="text-3xl font-bold text-emerald-900">Dashboard de Controle</h2>
                    <p class="text-slate-500">Acompanhe a saúde e o valor da sua coleção</p>
                </div>
                <div class="hidden md:block text-right">
                    <p id="current-date" class="font-medium text-slate-600"></p>
                </div>
            </header>

            <!-- KPI Cards -->
            <section id="stats-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
                <div class="bg-white p-6 rounded-2xl shadow-sm border-b-4 border-emerald-500">
                    <p class="text-sm text-slate-500 font-semibold uppercase">Total de Plantas</p>
                    <h3 id="stat-total-plants" class="text-3xl font-bold text-emerald-700 mt-1">0</h3>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm border-b-4 border-lime-500">
                    <p class="text-sm text-slate-500 font-semibold uppercase">Volume de Vendas</p>
                    <h3 id="stat-total-sales" class="text-3xl font-bold text-lime-600 mt-1">R$ 0,00</h3>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm border-b-4 border-amber-500">
                    <p class="text-sm text-slate-500 font-semibold uppercase">Em Estoque</p>
                    <h3 id="stat-in-stock" class="text-3xl font-bold text-amber-600 mt-1">0</h3>
                </div>
                <div class="bg-white p-6 rounded-2xl shadow-sm border-b-4 border-red-500">
                    <p class="text-sm text-slate-500 font-semibold uppercase">Alertas de Pragas</p>
                    <h3 id="stat-pest-alerts" class="text-3xl font-bold text-red-600 mt-1">0</h3>
                </div>
            </section>

            <div id="tab-dashboard" class="space-y-8">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <div class="bg-white p-6 rounded-2xl shadow-sm">
                        <h4 class="text-lg font-bold mb-4 flex items-center gap-2">
                            <i class="fas fa-chart-line text-emerald-600"></i> Volume de Vendas Mensal
                        </h4>
                        <div class="h-64">
                            <canvas id="salesChart"></canvas>
                        </div>
                    </div>
                    <div class="bg-white p-6 rounded-2xl shadow-sm overflow-hidden">
                        <h4 class="text-lg font-bold mb-4 flex items-center gap-2">
                            <i class="fas fa-bug text-red-500"></i> Últimos Tratamentos
                        </h4>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm">
                                <thead>
                                    <tr class="border-b">
                                        <th class="pb-3">Espécie</th>
                                        <th class="pb-3">Praga</th>
                                        <th class="pb-3">Tratamento</th>
                                    </tr>
                                </thead>
                                <tbody id="pest-summary-list">
                                    <!-- Dynamic items -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div id="tab-inventory" class="hidden">
                <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-slate-50 text-slate-600 uppercase text-xs font-bold">
                                <tr>
                                    <th class="p-4">Espécie</th>
                                    <th class="p-4">Idade</th>
                                    <th class="p-4">Últ. Adubação</th>
                                    <th class="p-4">Status</th>
                                    <th class="p-4">Valor</th>
                                    <th class="p-4 text-center">Ações</th>
                                </tr>
                            </thead>
                            <tbody id="inventory-table-body">
                                <!-- Dynamic items -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <div id="bonsai-modal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
            <div class="p-6 border-b flex justify-between items-center sticky top-0 bg-white">
                <h3 id="modal-title" class="text-xl font-bold text-emerald-900">Novo Bonsai</h3>
                <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-2xl">&times;</button>
            </div>
            <form id="bonsai-form" class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
                <input type="hidden" id="edit-id">

                <div class="md:col-span-2">
                    <label class="block text-sm font-semibold mb-1">Espécie</label>
                    <input type="text" id="form-especie" required class="w-full p-2 border rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">Data de Compra</label>
                    <input type="date" id="form-data-compra" required class="w-full p-2 border rounded-lg">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">Data Germinação (Início)</label>
                    <input type="date" id="form-data-germinacao" required class="w-full p-2 border rounded-lg">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">Última Adubação</label>
                    <input type="date" id="form-ultima-adubacao" class="w-full p-2 border rounded-lg">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">Data Controle Pragas</label>
                    <input type="date" id="form-data-pragas" class="w-full p-2 border rounded-lg">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">Praga Identificada</label>
                    <input type="text" id="form-identificacao-praga" placeholder="Ex: Pulgão" class="w-full p-2 border rounded-lg">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">Tratamento</label>
                    <input type="text" id="form-tratamento" placeholder="Ex: Óleo de Neem" class="w-full p-2 border rounded-lg">
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">Status</label>
                    <select id="form-status" class="w-full p-2 border rounded-lg">
                        <option value="Em Estoque">Em Estoque</option>
                        <option value="Vendido">Vendido</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold mb-1">Valor de Venda (R$)</label>
                    <input type="number" id="form-valor-venda" step="0.01" class="w-full p-2 border rounded-lg">
                </div>

                <div class="md:col-span-2 mt-4 flex gap-3">
                    <button type="submit" class="flex-1 bg-emerald-600 text-white font-bold py-3 rounded-lg hover:bg-emerald-700 transition">Salvar Bonsai</button>
                    <button type="button" onclick="closeModal()" class="flex-1 bg-slate-100 text-slate-600 font-bold py-3 rounded-lg hover:bg-slate-200 transition">Cancelar</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Data Management
        let bonsais = [
        { id: 1, especie: 'Juniperus Procumbens', dataCompra: '2022-01-15', dataGerminacao: '2020-05-20', ultimaAdubacao: '2023-10-01', dataPragas: '2023-09-15', praga: 'Pulgão', tratamento: 'Óleo de Neem', status: 'Em Estoque', valor: 0, dataVenda: '' },
        { id: 2, especie: 'Acer Palmatum', dataCompra: '2021-06-10', dataGerminacao: '2018-03-12', ultimaAdubacao: '2023-11-12', dataPragas: '2023-11-01', praga: 'Nenhuma', tratamento: 'Nenhum', status: 'Vendido', valor: 1200, dataVenda: '2023-12-01' },
        { id: 3, especie: 'Ficus Retusa', dataCompra: '2023-02-20', dataGerminacao: '2015-08-30', ultimaAdubacao: '2023-12-05', dataPragas: '2023-11-20', praga: 'Cochonilha', tratamento: 'Inseticida Orgânico', status: 'Em Estoque', valor: 0, dataVenda: '' },
        { id: 4, especie: 'Ulmus Parvifolia', dataCompra: '2020-11-05', dataGerminacao: '2017-01-10', ultimaAdubacao: '2023-09-20', dataPragas: '2023-10-10', praga: 'Nenhuma', tratamento: 'Nenhum', status: 'Vendido', valor: 850, dataVenda: '2023-11-15' }
        ];

        let salesChart;

        // Initialization
        window.onload = () => {
        document.getElementById('current-date').innerText = new Date().toLocaleDateString('pt-BR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
        initChart();
        updateUI();
        };

        // UI Updates
        function updateUI() {
        renderStats();
        renderInventory();
        renderPestTable();
        updateChart();
        }

        function renderStats() {
        const total = bonsais.length;
        const sales = bonsais.reduce((sum, b) => sum + (Number(b.valor) || 0), 0);
        const inStock = bonsais.filter(b => b.status === 'Em Estoque').length;
        const pests = bonsais.filter(b => b.praga !== 'Nenhuma' && b.praga !== '').length;

        document.getElementById('stat-total-plants').innerText = total;
        document.getElementById('stat-total-sales').innerText = `R$ ${sales.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
        document.getElementById('stat-in-stock').innerText = inStock;
        document.getElementById('stat-pest-alerts').innerText = pests;
        }

        function calculateAge(birthDate) {
        const today = new Date();
        const birth = new Date(birthDate);
        let age = today.getFullYear() - birth.getFullYear();
        const m = today.getMonth() - birth.getMonth();
        if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) age--;
        return age + ' anos';
        }

        function renderInventory() {
        const tbody = document.getElementById('inventory-table-body');
        tbody.innerHTML = '';

        bonsais.forEach(b => {
        const tr = document.createElement('tr');
        tr.className = 'border-b hover:bg-slate-50 transition';
        tr.innerHTML = `
        <td class="p-4 font-semibold">${b.especie}</td>
        <td class="p-4">${calculateAge(b.dataGerminacao)}</td>
        <td class="p-4">${b.ultimaAdubacao ? new Date(b.ultimaAdubacao).toLocaleDateString('pt-BR') : '---'}</td>
        <td class="p-4">
        <span class="px-2 py-1 rounded-full text-xs font-bold ${b.status === 'Vendido' ? 'bg-blue-100 text-blue-700' : 'bg-emerald-100 text-emerald-700'}">
        ${b.status}
        </span>
        </td>
        <td class="p-4 font-medium">${b.valor > 0 ? 'R$ ' + b.valor : '---'}</td>
        <td class="p-4 text-center">
        <button onclick="editBonsai(${b.id})" class="text-blue-500 hover:text-blue-700 mx-2"><i class="fas fa-edit"></i></button>
        <button onclick="deleteBonsai(${b.id})" class="text-red-500 hover:text-red-700 mx-2"><i class="fas fa-trash"></i></button>
        </td>
        `;
        tbody.appendChild(tr);
        });
        }

        function renderPestTable() {
        const tbody = document.getElementById('pest-summary-list');
        tbody.innerHTML = '';
        const affected = bonsais.filter(b => b.praga !== 'Nenhuma' && b.praga !== '').slice(0, 5);

        affected.forEach(b => {
        tbody.innerHTML += `
        <tr class="border-b">
        <td class="py-3 font-medium">${b.especie}</td>
        <td class="py-3 text-red-600 font-bold">${b.praga}</td>
        <td class="py-3 text-slate-500">${b.tratamento}</td>
        </tr>
        `;
        });
        }

        // Chart Logic
        function initChart() {
        const ctx = document.getElementById('salesChart').getContext('2d');
        salesChart = new Chart(ctx, {
        type: 'line',
        data: {
        labels: ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'],
        datasets: [{
        label: 'Vendas (R$)',
        data: new Array(12).fill(0),
        borderColor: '#10b981',
        backgroundColor: 'rgba(16, 185, 129, 0.1)',
        tension: 0.4,
        fill: true
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true } }
        }
        });
        }

        function updateChart() {
        const monthlyData = new Array(12).fill(0);
        bonsais.forEach(b => {
        if (b.status === 'Vendido' && b.dataVenda) {
        const month = new Date(b.dataVenda).getMonth();
        monthlyData[month] += Number(b.valor);
        }
        });
        salesChart.data.datasets[0].data = monthlyData;
        salesChart.update();
        }

        // Tab Switching
        function switchTab(tab) {
        document.getElementById('tab-dashboard').classList.toggle('hidden', tab !== 'dashboard');
        document.getElementById('tab-inventory').classList.toggle('hidden', tab !== 'inventory');
        document.getElementById('page-title').innerText = tab === 'dashboard' ? 'Dashboard de Controle' : 'Inventário de Bonsais';

        // Update nav styling
        const buttons = document.querySelectorAll('aside nav button');
        buttons.forEach(btn => {
        if (btn.innerText.toLowerCase().includes(tab === 'dashboard' ? 'dashboard' : 'inventário')) {
        btn.classList.add('bg-emerald-800/50');
        } else {
        btn.classList.remove('bg-emerald-800/50');
        }
        });
        }

        // Modal Operations
        function openModal() {
        document.getElementById('bonsai-form').reset();
        document.getElementById('edit-id').value = '';
        document.getElementById('modal-title').innerText = 'Novo Bonsai';
        document.getElementById('bonsai-modal').classList.remove('hidden');
        }

        function closeModal() {
        document.getElementById('bonsai-modal').classList.add('hidden');
        }

        function editBonsai(id) {
        const b = bonsais.find(x => x.id === id);
        if (!b) return;

        document.getElementById('edit-id').value = b.id;
        document.getElementById('form-especie').value = b.especie;
        document.getElementById('form-data-compra').value = b.dataCompra;
        document.getElementById('form-data-germinacao').value = b.dataGerminacao;
        document.getElementById('form-ultima-adubacao').value = b.ultimaAdubacao;
        document.getElementById('form-data-pragas').value = b.dataPragas;
        document.getElementById('form-identificacao-praga').value = b.praga;
        document.getElementById('form-tratamento').value = b.tratamento;
        document.getElementById('form-status').value = b.status;
        document.getElementById('form-valor-venda').value = b.valor;

        document.getElementById('modal-title').innerText = 'Editar Bonsai';
        document.getElementById('bonsai-modal').classList.remove('hidden');
        }

        function deleteBonsai(id) {
        if (confirm('Tem certeza que deseja excluir este registro?')) {
        bonsais = bonsais.filter(b => b.id !== id);
        updateUI();
        }
        }

        // Form Submission
        document.getElementById('bonsai-form').onsubmit = (e) => {
        e.preventDefault();
        const id = document.getElementById('edit-id').value;

        const bonsaiData = {
        id: id ? parseInt(id) : Date.now(),
        especie: document.getElementById('form-especie').value,
        dataCompra: document.getElementById('form-data-compra').value,
        dataGerminacao: document.getElementById('form-data-germinacao').value,
        ultimaAdubacao: document.getElementById('form-ultima-adubacao').value,
        dataPragas: document.getElementById('form-data-pragas').value,
        praga: document.getElementById('form-identificacao-praga').value || 'Nenhuma',
        tratamento: document.getElementById('form-tratamento').value || 'Nenhum',
        status: document.getElementById('form-status').value,
        valor: parseFloat(document.getElementById('form-valor-venda').value) || 0,
        dataVenda: document.getElementById('form-status').value === 'Vendido' ? new Date().toISOString().split('T')[0] : ''
        };

        if (id) {
        const index = bonsais.findIndex(b => b.id === parseInt(id));
        bonsais[index] = bonsaiData;
        } else {
        bonsais.push(bonsaiData);
        }

        closeModal();
        updateUI();
        };

    </script>
</body>
</html>